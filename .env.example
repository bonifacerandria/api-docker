NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=dev

# --- PostgreSQL (branché applicativement au module 5, service Docker dès maintenant) ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change_me_in_production

# --- Registre Docker (module 9) ---
# Nécessaire uniquement en production (docker-compose.yml sans l'override
# de build). Ton nom d'utilisateur Docker Hub, PAS un secret en soi (déjà
# visible dans l'URL publique de l'image), mais garde .env hors de Git quand même.
DOCKERHUB_USERNAME=bonifacemada
# Laisse "latest" en temps normal. Le script de déploiement (module 10)
# surcharge cette valeur automatiquement pour déployer un tag précis.
IMAGE_TAG=latest

# --- Grafana (module 12) ---
# Jamais admin/admin en prod. Grafana n'est accessible que via tunnel SSH
# (voir docs/azure-notes.md), mais un mot de passe faible reste un mot de
# passe faible même derrière un tunnel.
GRAFANA_ADMIN_USER=boniface
GRAFANA_ADMIN_PASSWORD=Azerty*1234